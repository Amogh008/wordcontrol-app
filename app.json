{
  "expo": {
    "name": "DLT",
    "slug": "wordcontrol",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "com.amogh.dlt",
    "icon": "./assets/icon_wordcontrol.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/icon_wordcontrol.png",
      "supportsTablet": true
    },
    "android": {
      "versionCode": 5,
      "icon": "./assets/icon_wordcontrol.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon_wordcontrol.png"
      },
      "package": "com.amogh.dlt",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/icon_wordcontrol.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-dev-client",
      "./plugins/withPcmAudioPlayer.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon_wordcontrol.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#121110"
        }
      ]
    ]
  }
}
